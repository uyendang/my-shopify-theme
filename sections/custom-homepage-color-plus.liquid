{% schema %}
{
  "name": "Color Plus Grand Launch",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Announcement Badge",
      "default": "THE NEW ERA OF GEL POLISH"
    },
    {
      "type": "text",
      "id": "heading_prefix",
      "label": "Small Heading",
      "default": "INTRODUCING THE ALL-NEW"
    },
    {
      "type": "text",
      "id": "main_heading",
      "label": "Main Headline",
      "default": "gelish® COLOR PLUS"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "250 Next-Gen Colors. Clean Copolymer Formula. Up to 21-Day Wear."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Showcase Image",
      "info": "Upload a high-res graphic or bottle cutout of Color Plus"
    },
    {
      "type": "collection",
      "id": "launch_collection",
      "label": "Select Color Plus Collection"
    },
    {
      "type": "url",
      "id": "primary_btn_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "primary_btn_text",
      "label": "Primary Button Label",
      "default": "EXPLORE ALL 250 SHADES →"
    },
    {
      "type": "url",
      "id": "secondary_btn_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_btn_text",
      "label": "Secondary Button Label",
      "default": "SHOP TRIPLE LUXE TRIO"
    }
  ],
  "presets": [
    {
      "name": "Color Plus Grand Launch"
    }
  ]
}
{% endschema %}

<div class="grand-launch-wrapper">
  <div class="grand-launch-container">
    
    <!-- LEFT COLUMN: ELEGANT LAUNCH COPY -->
    <div class="grand-launch-text">
      
      {% if section.settings.badge_text != blank %}
        <div class="launch-pulse-badge">
          <span class="pulse-dot"></span>
          {{ section.settings.badge_text }}
        </div>
      {% endif %}

      <span class="launch-prefix">{{ section.settings.heading_prefix }}</span>
      <h1 class="launch-title">{{ section.settings.main_heading }}</h1>
      <p class="launch-sub">{{ section.settings.subheading }}</p>

      <!-- STATS COUNTER BAR -->
      <div class="launch-stats-grid">
        <div class="stat-card">
          <span class="stat-num">250</span>
          <span class="stat-lbl">Vibrant Shades</span>
        </div>
        <div class="stat-card">
          <span class="stat-num">21+</span>
          <span class="stat-lbl">Days Wear</span>
        </div>
        <div class="stat-card">
          <span class="stat-num">100%</span>
          <span class="stat-lbl">HEMA & TPO Free</span>
        </div>
      </div>

      <!-- FEATURE HIGHLIGHT PILLS -->
      <div class="launch-feature-tags">
        <span>✨ True-Color Bottle Match</span>
        <span>🖌️ ProGel 880 Brush</span>
        <span>💎 25% Higher Shine Top Coat</span>
      </div>

      <!-- ACTION BUTTONS -->
      <div class="launch-cta-group">
        {% assign shop_url = section.settings.primary_btn_link | default: collections[section.settings.launch_collection].url %}
        <a href="{{ shop_url }}" class="launch-btn-primary">
          {{ section.settings.primary_btn_text }}
        </a>

        {% if section.settings.secondary_btn_link != blank %}
          <a href="{{ section.settings.secondary_btn_link }}" class="launch-btn-secondary">
            {{ section.settings.secondary_btn_text }}
          </a>
        {% endif %}
      </div>

    </div>

    <!-- RIGHT COLUMN: ELEGANT VISUAL SHOWCASE -->
    <div class="grand-launch-visual">
      <div class="visual-glow-backdrop"></div>
      
      {% if section.settings.hero_image != blank %}
        <img 
          src="{{ section.settings.hero_image | image_url: width: 1200 }}" 
          alt="Gelish Color Plus Grand Launch"
          class="launch-hero-img"
          loading="eager"
        >
      {% else %}
        <!-- GRAPHIC FALLBACK SHOWCASE CARD -->
        <div class="launch-visual-fallback">
          <div class="fallback-content">
            <span class="big-bold-tag">250</span>
            <span class="sub-bold-tag">COLOR REVOLUTION</span>
            <p class="fallback-desc">Next-Gen Clean Copolymer Formulation</p>
          </div>
        </div>
      {% endif %}
    </div>

  </div>
</div>

<style>
  .grand-launch-wrapper {
    width: 100%;
    background: #FAF6F4;
    color: #5A3D31;
    padding: 70px 20px;
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid #EFE4DF;
  }

  .grand-launch-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 60px;
    align-items: center;
  }

  /* Elegant Badge */
  .launch-pulse-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #F3E5E3;
    border: 1px solid #E5CECB;
    color: #8C585C;
    padding: 6px 16px;
    border-radius: 30px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 22px;
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    background-color: #B38487;
    border-radius: 50%;
    box-shadow: 0 0 8px #B38487;
    animation: pulseGlow 1.8s infinite;
  }

  @keyframes pulseGlow {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(179, 132, 135, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(179, 132, 135, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(179, 132, 135, 0); }
  }

  /* Typography */
  .launch-prefix {
    display: block;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 2.5px;
    color: #8C585C;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .launch-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(38px, 4.5vw, 58px);
    font-weight: 700;
    line-height: 1.1;
    margin: 0 0 16px 0;
    color: #5A3D31;
  }

  .launch-sub {
    font-size: 17px;
    line-height: 1.6;
    color: #775A51;
    margin-bottom: 30px;
    max-width: 540px;
  }

  /* Stats Grid */
  .launch-stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
    margin-bottom: 28px;
    padding: 20px;
    background: #ffffff;
    border-radius: 12px;
    border: 1px solid #EFE4DF;
    box-shadow: 0 4px 15px rgba(90, 61, 49, 0.03);
  }

  .stat-card {
    text-align: center;
  }

  .stat-num {
    display: block;
    font-family: 'Playfair Display', serif;
    font-size: 32px;
    font-weight: 700;
    color: #5A3D31;
    line-height: 1;
    margin-bottom: 4px;
  }

  .stat-lbl {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #8C585C;
    font-weight: 600;
  }

  /* Feature Tags */
  .launch-feature-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 35px;
  }

  .launch-feature-tags span {
    background: #FFFFFF;
    border: 1px solid #EAE0DC;
    color: #6E5046;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 500;
  }

  /* Action Buttons */
  .launch-cta-group {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .launch-btn-primary {
    background-color: #B38487;
    color: #ffffff;
    padding: 15px 34px;
    border-radius: 30px;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 1px;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(179, 132, 135, 0.25);
    transition: all 0.3s ease;
  }

  .launch-btn-primary:hover {
    background-color: #926669;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(179, 132, 135, 0.35);
  }

  .launch-btn-secondary {
    background: transparent;
    color: #5A3D31;
    border: 1.5px solid #5A3D31;
    padding: 14px 28px;
    border-radius: 30px;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 1px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .launch-btn-secondary:hover {
    background: #5A3D31;
    color: #ffffff;
  }

  /* Visual Showcase */
  .grand-launch-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .visual-glow-backdrop {
    position: absolute;
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, rgba(230, 0, 126, 0.12) 0%, rgba(250, 246, 244, 0) 70%);
    border-radius: 50%;
    z-index: 1;
    filter: blur(30px);
  }

  .launch-hero-img {
    position: relative;
    z-index: 2;
    max-width: 100%;
    height: auto;
    filter: drop-shadow(0 10px 20px rgba(90, 61, 49, 0.1));
    transition: transform 0.5s ease;
  }

  .launch-hero-img:hover {
    transform: scale(1.02);
  }

  .launch-visual-fallback {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 380px;
    background: #ffffff;
    border: 1px solid #EFE4DF;
    border-radius: 20px;
    box-shadow: 0 8px 30px rgba(90, 61, 49, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 30px;
  }

  .big-bold-tag {
    display: block;
    font-family: 'Playfair Display', serif;
    font-size: 84px;
    font-weight: 700;
    line-height: 0.9;
    color: #B38487;
    margin-bottom: 8px;
  }

  .sub-bold-tag {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 3px;
    color: #5A3D31;
    display: block;
    margin-bottom: 6px;
  }

  .fallback-desc {
    font-size: 13px;
    color: #888888;
    margin: 0;
  }

  /* Responsive Adjustments */
  @media (max-width: 989px) {
    .grand-launch-wrapper {
      padding: 45px 20px;
    }

    .grand-launch-container {
      grid-template-columns: 1fr;
      gap: 35px;
      text-align: center;
    }

    .launch-sub {
      margin-left: auto;
      margin-right: auto;
    }

    .launch-pulse-badge {
      margin-left: auto;
      margin-right: auto;
    }

    .launch-feature-tags,
    .launch-cta-group {
      justify-content: center;
    }

    .launch-stats-grid {
      grid-template-columns: repeat(3, 1fr);
      padding: 15px 10px;
    }

    .stat-num { font-size: 24px; }
    .stat-lbl { font-size: 9px; }
  }
</style>