{% schema %}
{
  "name": "Color Plus Centered Hero",
  "settings": [],
  "presets": [
    {
      "name": "Color Plus Centered Hero"
    }
  ]
}
{% endschema %}

<div class="cp-centered-hero">
  <div class="cp-centered-container">
    <span class="cp-top-tag">NEW PRODUCT LINE LAUNCH</span>
    <h1 class="cp-centered-title">gelish® COLOR PLUS</h1>
    <p class="cp-centered-lead">Clean, Vibrant Color. Zero Compromise. Up to 21-Days of Wear.</p>

    <!-- 4-STAT GRID -->
    <div class="cp-stats-row">
      <div class="cp-stat-box">
        <span class="stat-number">250</span>
        <span class="stat-label">ALL-NEW SHADES</span>
      </div>
      <div class="cp-stat-box">
        <span class="stat-number">100%</span>
        <span class="stat-label">HEMA & TPO FREE</span>
      </div>
      <div class="cp-stat-box">
        <span class="stat-number">2x</span>
        <span class="stat-label">BRISTLE DENSITY</span>
      </div>
      <div class="cp-stat-box">
        <span class="stat-number">+25%</span>
        <span class="stat-label">TOP COAT SHINE</span>
      </div>
    </div>

    <!-- BUTTON GROUP -->
    <div class="cp-centered-actions">
      <a href="/collections/gelish-color-plus" class="btn-main">SHOP THE COLLECTION</a>
      <a href="/collections/gelish-color-plus" class="btn-sub">EXPLORE TRIPLE LUXE TRIO</a>
    </div>
  </div>
</div>

<style>
  .cp-centered-hero {
    width: 100%;
    background: linear-gradient(180deg, #FAF6F4 0%, #F3E5E3 100%);
    padding: 80px 20px;
    border-bottom: 1px solid #E5CECB;
    text-align: center;
  }

  .cp-centered-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .cp-top-tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    color: #8C585C;
    text-transform: uppercase;
    display: block;
    margin-bottom: 12px;
  }

  .cp-centered-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(42px, 5.5vw, 68px);
    font-weight: 700;
    color: #5A3D31;
    margin: 0 0 16px 0;
    line-height: 1.05;
  }

  .cp-centered-lead {
    font-size: 18px;
    color: #775A51;
    margin-bottom: 40px;
  }

  .cp-stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
    background: #ffffff;
    padding: 25px 20px;
    border-radius: 12px;
    border: 1px solid #EFE4DF;
    box-shadow: 0 4px 20px rgba(90, 61, 49, 0.04);
    margin-bottom: 40px;
  }

  .cp-stat-box {
    text-align: center;
  }

  .stat-number {
    display: block;
    font-family: 'Playfair Display', serif;
    font-size: 32px;
    font-weight: 700;
    color: #5A3D31;
    line-height: 1;
    margin-bottom: 4px;
  }

  .stat-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #8C585C;
  }

  .cp-centered-actions {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .btn-main {
    background-color: #5A3D31;
    color: #ffffff;
    padding: 16px 36px;
    border-radius: 30px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-decoration: none;
    transition: background 0.3s ease;
  }

  .btn-main:hover {
    background-color: #8C585C;
  }

  .btn-sub {
    background-color: transparent;
    color: #5A3D31;
    border: 1.5px solid #5A3D31;
    padding: 15px 32px;
    border-radius: 30px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .btn-sub:hover {
    background-color: #5A3D31;
    color: #ffffff;
  }

  @media (max-width: 767px) {
    .cp-stats-row {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }
</style>