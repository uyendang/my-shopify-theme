{% schema %}
{
  "name": "Full Video Gallery",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Page Heading",
      "default": "All How-To Tutorials & Guides"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Step-by-step application and removal guides for all product lines."
    }
  ],
  "blocks": [
    {
      "type": "video_item",
      "name": "Video Tutorial",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Video Title",
          "default": "How to Apply Gel Polish"
        },
        {
          "type": "select",
          "id": "category",
          "label": "Category Tag",
          "options": [
            { "value": "Gel Polish", "label": "Gel Polish" },
            { "value": "Cream Gel", "label": "Cream Gel" },
            { "value": "Builder Gel", "label": "Builder Gel" },
            { "value": "Soft Gel Tips", "label": "Soft Gel Tips" },
            { "value": "Nail Polish", "label": "Nail Polish" },
            { "value": "Dip Powder", "label": "Dip Powder" },
            { "value": "Foundation Flex", "label": "Foundation Flex" }
          ],
          "default": "Gel Polish"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "YouTube or Vimeo Link",
          "accept": ["youtube", "vimeo"],
          "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Full Video Gallery"
    }
  ]
}
{% endschema %}

{% comment %} Array of categories to group by {% endcomment %}
{% assign categories = "Gel Polish,Cream Gel,Builder Gel,Soft Gel Tips,Nail Polish,Dip Powder" | split: "," %}

<div class="full-gallery-section">
  <div class="full-gallery-container">
    {% if section.settings.heading != blank %}
      <h1 class="full-gallery-heading">{{ section.settings.heading }}</h1>
    {% endif %}
    
    {% if section.settings.subheading != blank %}
      <p class="full-gallery-subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    {% comment %} Loop through each category to create a slider row {% endcomment %}
    {% for cat in categories %}
      {% assign cat_has_videos = false %}
      
      {% for block in section.blocks %}
        {% if block.settings.category == cat %}
          {% assign cat_has_videos = true %}
          {% break %}
        {% endif %}
      {% endfor %}

      {% if cat_has_videos %}
        <div class="category-row">
          <div class="category-header">
            <h2 class="category-title">{{ cat }} Tutorials</h2>
            <span class="swipe-hint">Swipe to see more →</span>
          </div>

          <div class="category-slider">
            {% for block in section.blocks %}
              {% if block.settings.category == cat %}
                <div class="full-gallery-card" {{ block.shopify_attributes }}>
                  <div class="full-gallery-video-wrapper">
                    {% if block.settings.video_url.type == 'youtube' %}
                      <iframe 
                        src="https://www.youtube.com/embed/{{ block.settings.video_url.id }}" 
                        frameborder="0" 
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                        allowfullscreen>
                      </iframe>
                    {% elsif block.settings.video_url.type == 'vimeo' %}
                      <iframe 
                        src="https://player.vimeo.com/video/{{ block.settings.video_url.id }}" 
                        frameborder="0" 
                        allow="autoplay; fullscreen; picture-in-picture" 
                        allowfullscreen>
                      </iframe>
                    {% endif %}
                  </div>
                  <div class="full-gallery-info">
                    <span class="full-gallery-badge">{{ block.settings.category }}</span>
                    <h3 class="full-gallery-title">{{ block.settings.title }}</h3>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    {% endfor %}

  </div>
</div>

<style>
  .full-gallery-section {
    padding: 60px 20px;
    background-color: #FAF6F4;
    min-height: 80vh;
  }
  .full-gallery-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .full-gallery-heading {
    font-family: 'Playfair Display', serif;
    font-size: 34px;
    color: #5A3D31;
    text-align: center;
    margin-bottom: 8px;
  }
  .full-gallery-subheading {
    font-size: 16px;
    color: #666;
    text-align: center;
    margin-bottom: 50px;
  }

  /* Category Section Layout */
  .category-row {
    margin-bottom: 55px;
  }
  .category-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 2px solid #EAE0DD;
    padding-bottom: 10px;
    margin-bottom: 20px;
  }
  .category-title {
    font-family: 'Playfair Display', serif;
    font-size: 24px;
    color: #5A3D31;
    margin: 0;
  }
  .swipe-hint {
    font-size: 13px;
    color: #8C585C;
    font-weight: 500;
  }

  /* Horizontal Carousel Slider */
  .category-slider {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    gap: 20px;
    padding-bottom: 15px;
    scrollbar-width: thin;
    scrollbar-color: #B38487 #FAF6F4;
  }

  .full-gallery-card {
    flex: 0 0 320px; /* Fixed width per slide card */
    scroll-snap-align: start;
    background: #ffffff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0,0,0,0.06);
    display: flex;
    flex-direction: column;
  }

  .full-gallery-video-wrapper {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
  }
  .full-gallery-video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .full-gallery-info {
    padding: 18px 20px;
  }
  .full-gallery-badge {
    display: inline-block;
    background-color: #F3E5E3;
    color: #8C585C;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 12px;
    margin-bottom: 10px;
    letter-spacing: 0.5px;
  }
  .full-gallery-title {
    font-family: 'Playfair Display', serif;
    font-size: 16px;
    color: #333333;
    margin: 0;
  }

  /* Responsive behavior for smaller screens */
  @media screen and (max-width: 767px) {
    .full-gallery-card {
      flex: 0 0 82%; /* Allows peek preview of next slide card on phone screens */
    }
    .category-slider {
      scrollbar-width: none; /* Hide scrollbar on touch screens */
    }
    .category-slider::-webkit-scrollbar {
      display: none;
    }
  }
</style>