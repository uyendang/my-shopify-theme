{% schema %}
{
  "name": "Color Plus Ribbon",
  "settings": [],
  "presets": [
    {
      "name": "Color Plus Ribbon"
    }
  ]
}
{% endschema %}

<div class="launch-ribbon-section">
  <div class="ribbon-container">
    <div class="ribbon-text-group">
      <span class="ribbon-pill">NEW LAUNCH</span>
      <h3>Gelish® Color Plus — 250 Next-Gen Colors</h3>
      <p>Clean Copolymer Formula • HEMA/TPO Free • 21+ Days Wear</p>
    </div>

    <div class="ribbon-action">
      <a href="/collections/gelish-color-plus" class="ribbon-btn">EXPLORE 250 SHADES →</a>
    </div>
  </div>
</div>

<style>
  .launch-ribbon-section {
    background: #5A3D31;
    color: #ffffff;
    padding: 20px;
    border-bottom: 2px solid #8C585C;
  }

  .ribbon-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .ribbon-text-group {
    display: flex;
    align-items: center;
    gap: 15px;
    flex-wrap: wrap;
  }

  .ribbon-pill {
    background: #8C585C;
    color: #ffffff;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
    padding: 4px 10px;
    border-radius: 12px;
  }

  .ribbon-text-group h3 {
    font-family: 'Playfair Display', serif;
    font-size: 20px;
    color: #FAF6F4;
    margin: 0;
  }

  .ribbon-text-group p {
    font-size: 13px;
    color: #D4B2A7;
    margin: 0;
  }

  .ribbon-btn {
    background: #FAF6F4;
    color: #5A3D31;
    padding: 12px 26px;
    border-radius: 25px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    text-decoration: none;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .ribbon-btn:hover {
    background: #8C585C;
    color: #ffffff;
  }

  @media (max-width: 767px) {
    .ribbon-container {
      flex-direction: column;
      text-align: center;
    }
    .ribbon-text-group {
      justify-content: center;
      flex-direction: column;
      gap: 6px;
    }
  }
</style>