{%- style -%}
  .gelish-foot-outer-{{ section.id }} {
    width: 100%;
    background-color: {{ section.settings.bg_color }};
    display: block;
    border-top: 1px solid {{ section.settings.border_color }};
  }

  .gelish-foot-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 20px 4%;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }

  .gelish-foot-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.9fr 0.9fr 1.2fr;
    gap: 60px;
    margin-bottom: 60px;
  }

  /* Column 1 - Brand Info */
  .gelish-foot-brand-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .gelish-foot-logo {
    font-family: 'Playfair Display', serif;
    font-size: 32px;
    font-weight: 700;
    color: {{ section.settings.text_dark }};
    text-decoration: none;
    margin-bottom: 20px;
    display: inline-block;
    letter-spacing: -0.5px;
  }

  .gelish-foot-logo span {
    color: {{ section.settings.accent_color }};
  }

  .gelish-foot-bio {
    font-size: 14px;
    line-height: 1.6;
    color: {{ section.settings.text_muted }};
    margin: 0 0 24px 0;
    font-weight: 300;
    max-width: 280px;
  }

  .gelish-foot-socials {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .gelish-foot-social-link {
    color: {{ section.settings.text_dark }};
    transition: color 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .gelish-foot-social-link:hover {
    color: {{ section.settings.accent_color }};
  }

  .gelish-foot-social-link svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  /* Link Columns 2 & 3 styling */
  .gelish-foot-title {
    font-family: 'Playfair Display', serif;
    font-size: 20px;
    color: {{ section.settings.text_dark }};
    margin: 0 0 24px 0;
    font-weight: 400;
  }

  .gelish-foot-links-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .gelish-foot-links-list li {
    margin-bottom: 12px;
  }

  .gelish-foot-link {
    font-size: 14px;
    color: {{ section.settings.text_muted }};
    text-decoration: none;
    font-weight: 300;
    transition: color 0.2s ease, padding-left 0.2s ease;
  }

  .gelish-foot-link:hover {
    color: {{ section.settings.accent_color }};
    padding-left: 2px;
  }

  .gelish-foot-newsletter-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .gelish-newsletter-desc {
    font-size: 14px;
    line-height: 1.6;
    color: {{ section.settings.text_muted }};
    margin: 0 0 24px 0;
    font-weight: 300;
    max-width: 300px;
  }

  /* Combined snuggled layout for input + join button */
  .gelish-newsletter-form-container {
    width: 100%;
    max-width: 320px;
  }

  .gelish-newsletter-form {
    display: flex;
    align-items: stretch;
    background-color: #ffffff;
    border: 1px solid {{ section.settings.border_color }};
    border-radius: 8px;
    overflow: hidden;
  }

  .gelish-newsletter-input {
    flex: 1;
    border: none;
    padding: 12px 16px;
    font-size: 13px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    color: {{ section.settings.text_dark }};
    background-color: transparent;
    outline: none;
    width: 100%;
  }

  .gelish-newsletter-input::placeholder {
    color: #999999;
  }

  .gelish-newsletter-btn {
    background-color: {{ section.settings.text_dark }};
    color: #ffffff;
    border: none;
    padding: 0 20px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .gelish-newsletter-btn:hover {
    opacity: 0.9;
  }

  .gelish-foot-divider {
    border: none;
    border-top: 1.5px solid {{ section.settings.border_color }};
    margin: 0 0 24px 0;
  }

  .gelish-foot-base {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    color: {{ section.settings.text_muted }};
    font-weight: 300;
  }

  .gelish-foot-legal-links {
    display: flex;
    gap: 24px;
    align-items: center;
  }

  .gelish-foot-legal-link {
    color: {{ section.settings.text_muted }};
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .gelish-foot-legal-link:hover {
    color: {{ section.settings.accent_color }};
  }

  @media screen and (max-width: 1024px) {
    .gelish-foot-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px;
    }
  }

  @media screen and (max-width: 650px) {
    .gelish-foot-container {
      padding: 20px;
    }
    .gelish-foot-grid {
      grid-template-columns: 1fr;
      gap: 32px;
      margin-bottom: 40px;
    }
    .gelish-foot-base {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 16px;
    }
    .gelish-foot-legal-links {
      flex-wrap: wrap;
      gap: 12px 20px;
    }
  }
{%- endstyle -%}

<div class="gelish-foot-outer-{{ section.id }}">
  <footer class="gelish-foot-container">
  {% comment %} 
    <div class="gelish-foot-grid">
      


       <div class="gelish-foot-brand-col">
        <a href="/" class="gelish-foot-logo">
          gelish<span>.</span>
        </a>
        <p class="gelish-foot-bio">{{ section.settings.brand_bio }}</p>
        
   
        <div class="gelish-foot-socials">
          {%- if section.settings.facebook_link != blank -%}
            <a href="{{ section.settings.facebook_link }}" class="gelish-foot-social-link" aria-label="Facebook">
              <svg viewBox="0 0 24 24"><path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c4.56-.93 8-4.96 8-9.75z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.instagram_link != blank -%}
            <a href="{{ section.settings.instagram_link }}" class="gelish-foot-social-link" aria-label="Instagram">
              <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.tiktok_link != blank -%}
            <a href="{{ section.settings.tiktok_link }}" class="gelish-foot-social-link" aria-label="TikTok">
              <svg viewBox="0 0 24 24"><path d="M12.525.02c1.31 0 2.59.3 3.75.87A7.435 7.435 0 0 1 18.525 3a7.41 7.41 0 0 1 .53-2.92c.69-.13 1.4-.2 2.11-.2H24v4.54a5.9 5.9 0 0 0-1.89-.5c-.71.07-1.39.3-2.02.66-.62.36-1.15.86-1.54 1.47a5.556 5.556 0 0 0-.67 2.06V14.5c0 .91-.18 1.8-.53 2.62a6.38 6.38 0 0 1-3.62 3.62 6.38 6.38 0 0 1-5.24 0 6.38 6.38 0 0 1-3.62-3.62A6.38 6.38 0 0 1 6 14.5c0-.91.18-1.8.53-2.62a6.38 6.38 0 0 1 1.47-2.15c.6-.53 1.33-.92 2.12-1.14a6.6 6.6 0 0 1 3.13.11V4.14c-1.3-.13-2.6-.01-3.85.34A9.9 9.9 0 0 0 4.13 7.23a10.87 10.87 0 0 0-1.52 3.84c-.2 1.3-.2 2.63.02 3.93a10.9 10.9 0 0 0 3.32 6.45c1.11.97 2.42 1.7 3.84 2.15 1.42.44 2.92.56 4.4.34a10.9 10.9 0 0 0 6.16-3.23c1.92-1.92 3.12-4.42 3.37-7.09V.02h-11.16z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.youtube_link != blank -%}
            <a href="{{ section.settings.youtube_link }}" class="gelish-foot-social-link" aria-label="YouTube">
              <svg viewBox="0 0 24 24"><path d="M23.498 6.163a3.003 3.003 0 0 0-2.11-2.11C19.518 3.545 12 3.545 12 3.545s-7.518 0-9.388.508a3.003 3.003 0 0 0-2.11 2.11C0 8.033 0 12 0 12s0 3.967.502 5.837a3.003 3.003 0 0 0 2.11 2.11c1.87.508 9.388.508 9.388.508s7.518 0 9.388-.508a3.003 3.003 0 0 0 2.11-2.11C24 15.967 24 12 24 12s0-3.967-.502-5.837zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

  
      <div class="gelish-foot-links-col">
        <h3 class="gelish-foot-title">{{ section.settings.menu1_title }}</h3>
        <ul class="gelish-foot-links-list">
          {%- if section.settings.menu1 != blank -%}
            {%- for link in section.settings.menu1.links -%}
              <li><a href="{{ link.url }}" class="gelish-foot-link">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
         
            <li><a href="#" class="gelish-foot-link">How to Apply Gelish</a></li>
            <li><a href="#" class="gelish-foot-link">Safe Removal Guides</a></li>
            <li><a href="#" class="gelish-foot-link">Shipping &amp; Delivery</a></li>
            <li><a href="#" class="gelish-foot-link">Contact Expert Technicians</a></li>
          {%- endif -%}
        </ul>
      </div>

      <div class="gelish-foot-links-col">
        <h3 class="gelish-foot-title">{{ section.settings.menu2_title }}</h3>
        <ul class="gelish-foot-links-list">
          {%- if section.settings.menu2 != blank -%}
            {%- for link in section.settings.menu2.links -%}
              <li><a href="{{ link.url }}" class="gelish-foot-link">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}

            <li><a href="#" class="gelish-foot-link">100% Authentic Product Seal</a></li>
            <li><a href="#" class="gelish-foot-link">HEMA-Free Safe Line</a></li>
            <li><a href="#" class="gelish-foot-link">Dealer Warranties</a></li>
            <li><a href="#" class="gelish-foot-link">Terms of Nail Style Blog</a></li>
          {%- endif -%}
        </ul>
      </div>


      <div class="gelish-foot-newsletter-col">
        <h3 class="gelish-foot-title">{{ section.settings.newsletter_title }}</h3>
        <p class="gelish-newsletter-desc">{{ section.settings.newsletter_desc }}</p>
        
        <div class="gelish-newsletter-form-container">
          {%- form 'customer', class: 'gelish-newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter, salon club">
            <input 
              type="email" 
              name="contact[email]" 
              class="gelish-newsletter-input" 
              placeholder="Salon email address"
              aria-label="Salon email address"
              required 
            >
            <button type="submit" class="gelish-newsletter-btn">
              Join
            </button>
          {%- endform -%}
        </div>
      </div>
    
    </div> 
    <hr class="gelish-foot-divider">
    {% endcomment %}

    <!-- Bottom copyrights and legal anchors alignment row -->
    <div class="gelish-foot-base">
      <div class="gelish-foot-copyright">
        &copy; {{ 'now' | date: "%Y" }} {{ section.settings.copyright_text }}
      </div>
      
      {% comment %} <div class="gelish-foot-legal-links">
        {%- if section.settings.privacy_link != blank -%}
          <a href="{{ section.settings.privacy_link }}" class="gelish-foot-legal-link">Privacy Policy</a>
        {%- else -%}
          <a href="#" class="gelish-foot-legal-link">Privacy Policy</a>
        {%- endif -%}
        
        {%- if section.settings.accessibility_link != blank -%}
          <a href="{{ section.settings.accessibility_link }}" class="gelish-foot-legal-link">Accessibility Statement</a>
        {%- else -%}
          <a href="#" class="gelish-foot-legal-link">Accessibility Statement</a>
        {%- endif -%}
      </div> {% endcomment %}
    </div>
  </footer>
</div>

{% schema %}
{
  "name": "Gelish Custom Footer",
  "settings": [
    {
      "type": "header",
      "content": "Theme Color Overrides"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Footer Background Color",
      "default": "#FAF6F3"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border/Divider Color",
      "default": "#EAE1DD"
    },
    {
      "type": "color",
      "id": "text_dark",
      "label": "Primary Headings/Logo",
      "default": "#231317"
    },
    {
      "type": "color",
      "id": "text_muted",
      "label": "Muted Links/Bio Text",
      "default": "#555555"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Focus (Logo Dot / Hovers)",
      "default": "#B58282"
    },
    {
      "type": "header",
      "content": "Column 1 Settings"
    },
    {
      "type": "textarea",
      "id": "brand_bio",
      "label": "Brand Biography Text",
      "default": "The pioneer of soak-off gel technology. Engineered for beauty, reliability, and ultimate health-conscious salon nail wear."
    },
    {
      "type": "url",
      "id": "facebook_link",
      "label": "Facebook Link"
    },
    {
      "type": "url",
      "id": "instagram_link",
      "label": "Instagram Link"
    },
    {
      "type": "url",
      "id": "tiktok_link",
      "label": "TikTok Link"
    },
    {
      "type": "url",
      "id": "youtube_link",
      "label": "YouTube Link"
    },
    {
      "type": "header",
      "content": "Column 2 Settings"
    },
    {
      "type": "text",
      "id": "menu1_title",
      "label": "Menu 1 Heading",
      "default": "Support & Care"
    },
    {
      "type": "link_list",
      "id": "menu1",
      "label": "Select Menu 1"
    },
    {
      "type": "header",
      "content": "Column 3 Settings"
    },
    {
      "type": "text",
      "id": "menu2_title",
      "label": "Menu 2 Heading",
      "default": "Guarantees"
    },
    {
      "type": "link_list",
      "id": "menu2",
      "label": "Select Menu 2"
    },
    {
      "type": "header",
      "content": "Column 4 Settings"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter Heading",
      "default": "Salon Exclusive Club"
    },
    {
      "type": "textarea",
      "id": "newsletter_desc",
      "label": "Newsletter Description",
      "default": "Subscribe to get launch alerts on seasonal shades and 15% off your first purchase."
    },
    {
      "type": "header",
      "content": "Footer Base Settings"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text holder name",
      "default": "Gelish International & Hand & Nail Harmony Inc. All Rights Reserved."
    },
    {
      "type": "url",
      "id": "privacy_link",
      "label": "Privacy Policy Link Override"
    },
    {
      "type": "url",
      "id": "accessibility_link",
      "label": "Accessibility Link Override"
    }
  ],
  "presets": [
    {
      "name": "Custom Footer"
    }
  ]
}
{% endschema %}