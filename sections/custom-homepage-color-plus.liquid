{% schema %}
{
  "name": "Color Plus 3-Card Banner",
  "settings": [],
  "presets": [
    {
      "name": "Color Plus 3-Card Banner"
    }
  ]
}
{% endschema %}

<div class="cp-three-card-banner">
  <div class="cp-three-card-container">
    
    <div class="cp-three-card-header">
      <span class="header-tag">COMPLETE LINE OVERVIEW</span>
      <h2>Introducing Gelish® Color Plus</h2>
      <p>Clean Copolymer Technology • True Color Bottles • 250 Shades</p>
    </div>

    <div class="cp-card-grid">
      
      <!-- CARD 1 -->
      <div class="cp-column-card">
        <span class="col-num">01</span>
        <h3>Next-Gen Formula</h3>
        <p>100% HEMA, TPO, and TPHP free formulation with increased cross-linking for up to 21 days of wear.</p>
        <ul class="col-check-list">
          <li>✓ Non-flammable</li>
          <li>✓ Cruelty-free</li>
          <li>✓ Enhanced scratch resistance</li>
        </ul>
      </div>

      <!-- CARD 2 -->
      <div class="cp-column-card featured-col">
        <span class="col-num">02</span>
        <h3>250 New Shades</h3>
        <p>Complete creative freedom ranging from classic standard cremes to magnetic cat eye effects and flash glitters.</p>
        <ul class="col-check-list">
          <li>✓ 145 Standard Cremes</li>
          <li>✓ 55 Flash Glitters</li>
          <li>✓ 40 Cat Eye Effects</li>
        </ul>
      </div>

      <!-- CARD 3 -->
      <div class="cp-column-card">
        <span class="col-num">03</span>
        <h3>Salon & Display Sets</h3>
        <p>Equip your store or salon with pre-assembled 60-count color boxes and LED-lighted display racks.</p>
        <ul class="col-check-list">
          <li>✓ Triple Luxe Trio Box</li>
          <li>✓ 60ct Salon Sets (#1–#4)</li>
          <li>✓ Painted Color Books</li>
        </ul>
      </div>

    </div>

    <div class="cp-three-card-footer">
      <a href="/collections/gelish-color-plus" class="btn-three-card">BROWSE FULL COLOR PLUS CATALOG →</a>
    </div>

  </div>
</div>

<style>
  .cp-three-card-banner {
    background-color: #FAF6F4;
    padding: 70px 20px;
    border-bottom: 1px solid #EFE4DF;
  }

  .cp-three-card-container {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  .header-tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    color: #8C585C;
    text-transform: uppercase;
  }

  .cp-three-card-header h2 {
    font-family: 'Playfair Display', serif;
    font-size: 38px;
    color: #5A3D31;
    margin: 8px 0;
  }

  .cp-three-card-header p {
    font-size: 15px;
    color: #775A51;
    margin-bottom: 45px;
  }

  .cp-card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 40px;
  }

  .cp-column-card {
    background: #ffffff;
    border: 1px solid #EFE4DF;
    border-radius: 12px;
    padding: 35px 25px;
    text-align: left;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 4px 15px rgba(90, 61, 49, 0.03);
  }

  .cp-column-card.featured-col {
    background: #F3E5E3;
    border-color: #E5CECB;
  }

  .col-num {
    font-family: 'Playfair Display', serif;
    font-size: 28px;
    font-weight: 700;
    color: #8C585C;
    margin-bottom: 10px;
    display: block;
  }

  .cp-column-card h3 {
    font-family: 'Playfair Display', serif;
    font-size: 22px;
    color: #5A3D31;
    margin: 0 0 10px 0;
  }

  .cp-column-card p {
    font-size: 14px;
    line-height: 1.6;
    color: #775A51;
    margin-bottom: 20px;
  }

  .col-check-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid rgba(90, 61, 49, 0.1);
    padding-top: 15px;
  }

  .col-check-list li {
    font-size: 13px;
    color: #5A3D31;
    margin-bottom: 8px;
  }

  .btn-three-card {
    display: inline-block;
    background-color: #5A3D31;
    color: #ffffff;
    padding: 16px 36px;
    border-radius: 30px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-decoration: none;
    transition: background 0.3s ease;
  }

  .btn-three-card:hover {
    background-color: #8C585C;
  }

  @media (max-width: 850px) {
    .cp-card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>