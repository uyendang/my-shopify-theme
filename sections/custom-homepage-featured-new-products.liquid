      "content": "Right Side Image & Floating Badge"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product Showcase Image"
    },
    {
      "type": "text",
      "id": "stamp_text_line1",
      "label": "Floating Stamp Line 1",
      "default": "CORDLESS"
    },
    {
      "type": "text",
      "id": "stamp_text_line2",
