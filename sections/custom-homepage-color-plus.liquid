{% schema %}
{
  "name": "Color Plus Editorial",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "WORLDWIDE LAUNCH — 2026"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Gelish® Color Plus"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "250 Shades of Clean, High-Impact Performance."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Formulated with next-generation clean copolymer technology. Free of HEMA, TPO, and TPHP. Built for up to 21 days of flawless salon wear."
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text",
      "default": "EXPLORE THE COLOR BOOK →"
    },
    {
      "type": "image_picker",
      "id": "featured_img",
      "label": "Featured Product Image"
    }
  ],
  "presets": [
    {
      "name": "Color Plus Editorial"
    }
  ]
}
{% endschema %}

<div class="editorial-launch-section">
  <div class="editorial-container">
    
    <!-- LEFT CONTENT BLOCK -->
    <div class="editorial-content">
      <span class="editorial-eyebrow">{{ section.settings.eyebrow }}</span>
      <h1 class="editorial-title">{{ section.settings.title }}</h1>
      <p class="editorial-sub">{{ section.settings.subtitle }}</p>
      <p class="editorial-body">{{ section.settings.description }}</p>

      <div class="editorial-bullets">
        <div class="bullet-item">
          <strong>145</strong> Standard Cremes
        </div>
        <div class="bullet-item">
          <strong>55</strong> Flash Glitters
        </div>
        <div class="bullet-item">
          <strong>40</strong> Cat Eye Effects
        </div>
      </div>

      <a href="{{ section.settings.cta_link }}" class="editorial-btn">
        {{ section.settings.cta_text }}
      </a>
    </div>

    <!-- RIGHT HERO IMAGE WITH PALETTE STRIP -->
    <div class="editorial-visual-wrapper">
      <div class="color-palette-bar">
        <span style="background: #a82036;" title="Heels Over Feels"></span>
        <span style="background: #e65275;" title="Soft Pink"></span>
        <span style="background: #8b3a7a;" title="Hot Mess Express"></span>
        <span style="background: #1a1a1a;" title="Black Tie Vibe"></span>
        <span style="background: #f4efe9;" title="Hard Launch"></span>
      </div>

      <div class="editorial-image-frame">
        {% if section.settings.featured_img != blank %}
          <img src="{{ section.settings.featured_img | image_url: width: 1000 }}" alt="Gelish Color Plus" loading="eager">
        {% else %}
          <div class="editorial-placeholder">
            <span>250</span>
            <p>TRUE COLOR REVOLUTION</p>
          </div>
        {% endif %}
      </div>
    </div>

  </div>
</div>

<style>
  .editorial-launch-section {
    background-color: #FAF6F4;
    padding: 80px 20px;
    border-bottom: 1px solid #EFE4DF;
  }

  .editorial-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 70px;
    align-items: center;
  }

  .editorial-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    color: #8C585C;
    text-transform: uppercase;
    display: block;
    margin-bottom: 12px;
  }

  .editorial-title {
    font-family: 'Playfair Display', serif;
    font-size: 52px;
    font-weight: 700;
    color: #5A3D31;
    margin: 0 0 16px 0;
    line-height: 1.08;
  }

  .editorial-sub {
    font-size: 20px;
    font-weight: 600;
    color: #8C585C;
    margin-bottom: 16px;
    line-height: 1.3;
  }

  .editorial-body {
    font-size: 15px;
    line-height: 1.7;
    color: #775A51;
    margin-bottom: 30px;
  }

  .editorial-bullets {
    display: flex;
    gap: 25px;
    margin-bottom: 35px;
    padding-top: 20px;
    border-top: 1px solid #EAE0DC;
  }

  .bullet-item {
    font-size: 13px;
    color: #5A3D31;
  }

  .bullet-item strong {
    display: block;
    font-size: 24px;
    font-family: 'Playfair Display', serif;
    color: #8C585C;
  }

  .editorial-btn {
    display: inline-block;
    background-color: #5A3D31;
    color: #ffffff;
    padding: 16px 36px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    text-decoration: none;
    transition: background 0.3s ease;
  }

  .editorial-btn:hover {
    background-color: #8C585C;
  }

  /* Right Visual */
  .editorial-visual-wrapper {
    position: relative;
    display: flex;
    gap: 15px;
  }

  .color-palette-bar {
    display: flex;
    flex-direction: column;
    gap: 8px;
    justify-content: center;
  }

  .color-palette-bar span {
    width: 14px;
    height: 50px;
    border-radius: 10px;
    transition: transform 0.2s ease;
  }

  .color-palette-bar span:hover {
    transform: scaleX(1.4);
  }

  .editorial-image-frame {
    flex: 1;
    background: #ffffff;
    border: 1px solid #EFE4DF;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(90, 61, 49, 0.06);
    min-height: 420px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .editorial-image-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .editorial-placeholder {
    text-align: center;
    padding: 40px;
  }

  .editorial-placeholder span {
    font-family: 'Playfair Display', serif;
    font-size: 96px;
    font-weight: 700;
    color: #B38487;
    line-height: 0.9;
    display: block;
  }

  .editorial-placeholder p {
    font-size: 13px;
    letter-spacing: 3px;
    font-weight: 700;
    color: #5A3D31;
    margin-top: 10px;
  }

  @media (max-width: 989px) {
    .editorial-container {
      grid-template-columns: 1fr;
      gap: 40px;
      text-align: center;
    }
    .editorial-bullets {
      justify-content: center;
    }
    .color-palette-bar {
      flex-direction: row;
      width: 100%;
      height: auto;
    }
    .color-palette-bar span {
      width: 100%;
      height: 12px;
    }
    .editorial-visual-wrapper {
      flex-direction: column-reverse;
    }
  }
</style>