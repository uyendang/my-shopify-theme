{% comment %}
  Shows a banner ABOVE the header ONLY if the customer is NOT logged in,
  and attaches itself to the sticky header so it stays visible on scroll.
{% endcomment %}

{% unless customer %}
  <div class="logged-out-sticky-bar" id="LoggedOutStickyBar">
    <div class="logged-out-sticky-bar__content">
      <a href="{{ section.settings.link_url }}" class="logged-out-sticky-bar__link">
        {{ section.settings.text }}
      </a>
    </div>
  </div>

  <style>
    .logged-out-sticky-bar {
      width: 100%;
      background-color: {{ section.settings.bg_color }};
      text-align: center;
      padding: 10px 15px;
      border-bottom: 1px solid rgba(0,0,0,0.1);
      box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }

    .logged-out-sticky-bar__link {
      color: {{ section.settings.text_color }};
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      font-size: 14px;
  
      letter-spacing: 0.5px;
      text-decoration: underline;
      display: inline-block;
      transition: opacity 0.2s ease;
    }

    .logged-out-sticky-bar__link:hover {
      opacity: 0.8;
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var bar = document.getElementById('LoggedOutStickyBar');
      // Finds your theme's main header component
      var header = document.querySelector('sticky-header') || document.querySelector('.header-wrapper') || document.querySelector('header');
      
      if (bar && header) {
        // Moves the bar to the very TOP inside the sticky header
        header.prepend(bar);
      }
    });
  </script>
{% endunless %}

{% schema %}
{
  "name": "Log In Announcement",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Banner Text",
      "default": "SIGN IN TO UNLOCK PRICING & SHOP"
    },
    {
      "type": "text",
      "id": "link_url",
      "label": "Link URL",
      "default": "/account/login"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Log In Announcement"
    }
  ]
}
{% endschema %}