{% schema %}
{
  "name": "Color Plus Swatch Hub",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "EXPLORE GELISH® COLOR PLUS"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "250 Next-Gen Shades matched 1:1 with true-color bottle technology."
    }
  ],
  "presets": [
    {
      "name": "Color Plus Swatch Hub"
    }
  ]
}
{% endschema %}

<div class="swatch-hub-section">
  <div class="swatch-hub-container">
    <div class="swatch-hub-header">
      <span class="hub-eyebrow">THE 250 SHADE PALETTE</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>

    <!-- CATEGORY PILL TABS -->
    <div class="swatch-tabs">
      <button class="tab-btn active" data-filter="all">All 250 Shades</button>
      <button class="tab-btn" data-filter="reds">True Reds</button>
      <button class="tab-btn" data-filter="nudes">Clean Nudes</button>
      <button class="tab-btn" data-filter="glitter">Flash Glitters (55)</button>
      <button class="tab-btn" data-filter="cateye">Cat Eye Effects (40)</button>
    </div>

    <!-- SWATCH GRID PREVIEW -->
    <div class="swatch-matrix">
      <div class="swatch-card" data-cat="reds">
        <div class="dot-preview" style="background: #a82036;"></div>
        <span class="swatch-name">Heels Over Feels</span>
        <span class="swatch-num">#141</span>
      </div>

      <div class="swatch-card" data-cat="nudes">
        <div class="dot-preview" style="background: #e3caa8;"></div>
        <span class="swatch-name">Bare With Me</span>
        <span class="swatch-num">#102</span>
      </div>

      <div class="swatch-card" data-cat="glitter">
        <div class="dot-preview" style="background: linear-gradient(135deg, #d4af37, #f7e7a1);"></div>
        <span class="swatch-name">Gilded Glam</span>
        <span class="swatch-num">#301</span>
      </div>

      <div class="swatch-card" data-cat="cateye">
        <div class="dot-preview" style="background: radial-gradient(circle, #8b3a7a, #1a1a1a);"></div>
        <span class="swatch-name">Hot Mess Express</span>
        <span class="swatch-num">#195</span>
      </div>

      <div class="swatch-card" data-cat="reds">
        <div class="dot-preview" style="background: #731222;"></div>
        <span class="swatch-name">Black Tie Vibe</span>
        <span class="swatch-num">#185</span>
      </div>

      <div class="swatch-card" data-cat="nudes">
        <div class="dot-preview" style="background: #f4efe9;"></div>
        <span class="swatch-name">Hard Launch</span>
        <span class="swatch-num">#101</span>
      </div>
    </div>

    <!-- FOOTER LINK -->
    <div class="swatch-hub-footer">
      <a href="/collections/gelish-color-plus" class="hub-cta-btn">
        BROWSE ALL 250 SHADES IN CATALOG SHEET →
      </a>
    </div>
  </div>
</div>

<style>
  .swatch-hub-section {
    background-color: #FAF6F4;
    padding: 70px 20px;
    border-bottom: 1px solid #EFE4DF;
  }

  .swatch-hub-container {
    max-width: 1100px;
    margin: 0 auto;
    text-align: center;
  }

  .hub-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    color: #8C585C;
    text-transform: uppercase;
  }

  .swatch-hub-header h2 {
    font-family: 'Playfair Display', serif;
    font-size: 38px;
    color: #5A3D31;
    margin: 8px 0;
  }

  .swatch-hub-header p {
    font-size: 15px;
    color: #775A51;
    margin-bottom: 35px;
  }

  .swatch-tabs {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 35px;
  }

  .tab-btn {
    background: #ffffff;
    border: 1px solid #EAE0DC;
    color: #5A3D31;
    padding: 10px 22px;
    border-radius: 25px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tab-btn.active, .tab-btn:hover {
    background: #5A3D31;
    color: #ffffff;
    border-color: #5A3D31;
  }

  .swatch-matrix {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 20px;
    margin-bottom: 40px;
  }

  .swatch-card {
    background: #ffffff;
    padding: 20px 15px;
    border-radius: 12px;
    border: 1px solid #EFE4DF;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    cursor: pointer;
  }

  .swatch-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(90, 61, 49, 0.06);
  }

  .dot-preview {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    margin: 0 auto 12px auto;
    box-shadow: 0 2px 6px rgba(0,0,0,0.15);
  }

  .swatch-name {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: #5A3D31;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .swatch-num {
    font-size: 11px;
    color: #8C585C;
    font-weight: 500;
  }

  .hub-cta-btn {
    display: inline-block;
    background-color: #B38487;
    color: #ffffff;
    padding: 15px 35px;
    border-radius: 30px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-decoration: none;
    transition: background 0.3s ease;
  }

  .hub-cta-btn:hover {
    background-color: #926669;
  }
</style>